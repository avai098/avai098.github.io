# ==========================================
# 1. Hugo 自动生成的构建产物与临时缓存
# ==========================================
/public/
/resources/_gen/
.hugo_build.lock
/_templates/
/archetypes/

# ==========================================
# 2. Obsidian 个人工作区与编辑状态（强烈建议忽略）
# ==========================================
.obsidian
# 忽略工作区布局与打开的标签页（避免频繁产生无意义的修改提示）
.obsidian/workspace.json
.obsidian/workspace-mobile.json
# 忽略 Obsidian 内部搜索和文件缓存
.obsidian/cache/

# ==========================================
# 3. 操作系统自动生成的临时文件
# ==========================================
# Windows 缩略图与文件夹自定义配置
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# macOS 系统元数据（如果你未来换 Mac 或跨系统协作）
.DS_Store

# ==========================================
# 4. 各种编辑器的临时配置与私密环境
# ==========================================
.vscode/
.idea/
*.swp
*.bak
*.tmp
.env